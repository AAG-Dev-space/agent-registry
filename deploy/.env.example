# A2A Agent Registry - Environment Configuration
# Copy this file to .env and customize values for your deployment

# Database
POSTGRES_PASSWORD=a2a_password_change_me

# Backend
SECRET_KEY=change-me-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Docker Registry Configuration
# Change this to your private Docker registry URL in production
# Examples:
#   - Harbor: https://harbor.company.com or http://localhost:5100
#   - GCR: https://gcr.io/your-project
#   - Docker Hub: https://registry-1.docker.io
#   - Local registry: http://localhost:5000
# NOTE: Use localhost instead of host.docker.internal for registries with hostname validation
DOCKER_REGISTRY_URL=http://localhost:5000

# Docker Registry Authentication (Optional)
# For Harbor, use Robot Account credentials
# For other registries, use appropriate username/password or token
# Leave empty for registries without authentication
#
# IMPORTANT: Use single quotes if username contains special characters like $
# Example for Harbor Robot Account:
#   DOCKER_REGISTRY_USERNAME='robot$agent-registry'
#   DOCKER_REGISTRY_PASSWORD=lCJy9i3jihpEneoyvuLm7EnMcC7c0X2i
DOCKER_REGISTRY_USERNAME=
DOCKER_REGISTRY_PASSWORD=
